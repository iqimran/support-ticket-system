# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cctv_support_ticket_system?schema=public"

# development | test | production
NODE_ENV="development"

# Random 32+ char secret used to HMAC session tokens before storing/looking
# them up. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Dev-only seed admin account (npx prisma db seed). Change the password
# before using this outside a local machine.
SEED_ADMIN_PHONE="01700000000"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_ADMIN_NAME="System Admin"

# Bearer token the production scheduler must send to trigger the daily
# ticket-archive job (GET /api/cron/archive, `Authorization: Bearer <this>`).
# Required in production, optional elsewhere. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See README.md "Scheduled jobs" for how to configure the scheduler itself.
ARCHIVE_JOB_SECRET="replace-with-a-random-64-char-hex-string"
