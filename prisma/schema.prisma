generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEAM_MEMBER
}

enum TicketStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE_BANKING
  OTHER
}

enum PaymentAuditAction {
  CREATED
  UPDATED
  DELETE_ATTEMPTED
}

enum ArchiveBatchStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

/// Login/auth identity + role. Business-facing team member profile data
/// lives on TeamMember, linked 1:1 via TeamMember.userId.
model User {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  teamMember          TeamMember?
  createdTickets      Ticket[]              @relation("TicketCreatedBy")
  assignmentsMade     TicketAssignment[]    @relation("AssignmentAssignedBy")
  statusChangesMade   TicketStatusHistory[] @relation("StatusChangedBy")
  ticketNotesWritten  TicketNote[]          @relation("TicketNoteCreatedBy")
  paymentsReceived    Payment[]             @relation("PaymentReceivedBy")
  paymentAuditEntries PaymentAuditLog[]     @relation("PaymentAuditChangedBy")
  auditLogEntries     AuditLog[]            @relation("AuditLogActor")
  sessions            Session[]
}

/// Server-side session record. The cookie holds a random opaque token; only
/// an HMAC hash of it is stored here so a DB leak alone can't be replayed
/// as a valid session.
model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Business profile for a TEAM_MEMBER-role User (assignment target, display
/// name/phone/availability). Kept separate from User so a team member can be
/// taken off assignment rotation (isActive = false here) without disabling
/// their login (User.isActive).
model TeamMember {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TicketAssignment[]
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  address   String?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
}

/// Tickets are never deleted and never moved to a separate table on
/// archival — archivedAt is just a marker so archived tickets stay
/// historically searchable through the same queries/indexes.
model Ticket {
  id           String         @id @default(cuid())
  ticketNumber String         @unique
  customerId   String
  problem      String
  status       TicketStatus   @default(PENDING)
  priority     TicketPriority @default(MEDIUM)
  createdBy    String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  completedAt  DateTime?
  archivedAt   DateTime?

  customer         Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  creator          User                  @relation("TicketCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  assignments      TicketAssignment[]
  statusHistory    TicketStatusHistory[]
  notes            TicketNote[]
  payments         Payment[]
  paymentAuditLogs PaymentAuditLog[]

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([archivedAt])
  @@index([status, completedAt])
}

model TicketAssignment {
  id           String   @id @default(cuid())
  ticketId     String
  teamMemberId String
  assignedBy   String
  assignedAt   DateTime @default(now())

  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Restrict)
  assigner   User       @relation("AssignmentAssignedBy", fields: [assignedBy], references: [id], onDelete: Restrict)

  // Prevents assigning the same team member to the same ticket twice.
  @@unique([ticketId, teamMemberId])
  @@index([teamMemberId, ticketId])
  @@index([teamMemberId, assignedAt])
}

model TicketStatusHistory {
  id        String       @id @default(cuid())
  ticketId  String
  oldStatus TicketStatus
  newStatus TicketStatus
  changedBy String
  note      String?
  createdAt DateTime     @default(now())

  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  changedByUser User   @relation("StatusChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model TicketNote {
  id        String   @id @default(cuid())
  ticketId  String
  createdBy String
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  creator User   @relation("TicketNoteCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

/// Actual money received from a customer. Rows are never deleted — see
/// PaymentAuditLog, whose Restrict relation back to this table makes
/// deletion impossible at the DB level once an audit trail exists (which
/// happens immediately on creation).
model Payment {
  id            String        @id @default(cuid())
  ticketId      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  note          String?
  receivedBy    String
  receivedAt    DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ticket    Ticket            @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  receiver  User              @relation("PaymentReceivedBy", fields: [receivedBy], references: [id], onDelete: Restrict)
  auditLogs PaymentAuditLog[]

  @@index([ticketId])
  @@index([receivedAt])
  @@index([receivedBy, receivedAt])
}

/// Append-only trail for every payment create/update/delete-attempt.
/// Read access must be restricted to ADMIN at the application layer.
model PaymentAuditLog {
  id               String             @id @default(cuid())
  paymentId        String
  ticketId         String
  action           PaymentAuditAction
  oldAmount        Decimal?           @db.Decimal(12, 2)
  newAmount        Decimal?           @db.Decimal(12, 2)
  oldPaymentMethod PaymentMethod?
  newPaymentMethod PaymentMethod?
  oldNote          String?
  newNote          String?
  changedBy        String
  createdAt        DateTime           @default(now())

  payment       Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  ticket        Ticket  @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  changedByUser User    @relation("PaymentAuditChangedBy", fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([ticketId])
  @@index([createdAt])
}

/// General security/business action log (login, logout, customer/ticket
/// mutations, assignments, status changes, payment changes, archive runs).
/// `action` is a free-form dot-namespaced string (e.g. "ticket.created")
/// rather than an enum, since this list is expected to grow without a
/// migration for every new action type. actorId is nullable to allow
/// system-initiated entries (e.g. an automatic archive job).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

/// One row per invocation of the ticket-archive job
/// (src/features/archive/service.ts). Each ticket is archived in its own
/// transaction, so a FAILED batch means everything up to ticketsProcessed
/// already committed successfully — the job is idempotent and safe to
/// re-run, since an already-archived ticket no longer exists in the live
/// Ticket table and will not be reselected as a candidate.
model ArchiveBatch {
  id               String             @id @default(cuid())
  startedAt        DateTime           @default(now())
  completedAt      DateTime?
  cutoffDate       DateTime
  status           ArchiveBatchStatus @default(RUNNING)
  ticketsFound     Int                @default(0)
  ticketsProcessed Int                @default(0)
  errorMessage     String?

  archivedTickets TicketArchive[]

  @@index([startedAt])
}

/// Archived copy of a Ticket older than the retention window (see
/// src/features/archive/cutoff.ts). Uses the SAME `id` as the original
/// Ticket row — this is the "reliable originalTicketId relationship": the
/// id IS the original ticket's id, so every historical reference (audit log
/// entityId, URLs already shared with a customer, etc.) keeps resolving
/// after archiving. Every related record type below preserves its original
/// id the same way.
///
/// customerId/createdBy are deliberately plain columns, not foreign keys:
/// Customer and User are live, permanent tables that archiving never
/// touches, so the id alone is a stable, sufficient pointer without
/// coupling this table's schema to theirs.
model TicketArchive {
  id             String         @id
  ticketNumber   String         @unique
  customerId     String
  problem        String
  status         TicketStatus
  priority       TicketPriority
  createdBy      String
  createdAt      DateTime
  updatedAt      DateTime
  completedAt    DateTime?
  archivedAt     DateTime       @default(now())
  archiveBatchId String

  batch            ArchiveBatch                 @relation(fields: [archiveBatchId], references: [id], onDelete: Restrict)
  assignments      TicketAssignmentArchive[]
  statusHistory    TicketStatusHistoryArchive[]
  notes            TicketNoteArchive[]
  payments         PaymentArchive[]
  paymentAuditLogs PaymentAuditLogArchive[]

  // Optimized for historical customer search (by customerId) and
  // ticket-number search (the unique constraint above already gives an
  // index for exact/prefix lookups); createdAt/archivedAt support
  // date-range historical queries the same way the live Ticket table does.
  @@index([customerId])
  @@index([createdAt])
  @@index([archivedAt])
  @@map("tickets_archive")
}

model TicketAssignmentArchive {
  id           String   @id
  ticketId     String
  teamMemberId String
  assignedBy   String
  assignedAt   DateTime

  ticket TicketArchive @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([teamMemberId])
  @@map("ticket_assignments_archive")
}

model TicketStatusHistoryArchive {
  id        String       @id
  ticketId  String
  oldStatus TicketStatus
  newStatus TicketStatus
  changedBy String
  note      String?
  createdAt DateTime

  ticket TicketArchive @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_status_history_archive")
}

model TicketNoteArchive {
  id        String   @id
  ticketId  String
  createdBy String
  note      String
  createdAt DateTime
  updatedAt DateTime

  ticket TicketArchive @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_notes_archive")
}

model PaymentArchive {
  id            String        @id
  ticketId      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  note          String?
  receivedBy    String
  receivedAt    DateTime
  createdAt     DateTime
  updatedAt     DateTime

  ticket    TicketArchive            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  auditLogs PaymentAuditLogArchive[]

  @@index([ticketId])
  @@index([receivedAt])
  @@map("payments_archive")
}

model PaymentAuditLogArchive {
  id               String             @id
  paymentId        String
  ticketId         String
  action           PaymentAuditAction
  oldAmount        Decimal?           @db.Decimal(12, 2)
  newAmount        Decimal?           @db.Decimal(12, 2)
  oldPaymentMethod PaymentMethod?
  newPaymentMethod PaymentMethod?
  oldNote          String?
  newNote          String?
  changedBy        String
  createdAt        DateTime

  payment PaymentArchive @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  ticket  TicketArchive  @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([ticketId])
  @@map("payment_audit_log_archive")
}
